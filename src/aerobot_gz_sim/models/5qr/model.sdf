<?xml version="1.0"?>
<sdf version="1.5">
    <model name='vehicle_qr5' canonical_link='chassis'>
      <pose>0 0 0 0 0 0</pose>

        <link name="qr5">    
             <collision name="collision">
                <pose>0 0 0.05 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://5qr/meshes/qr.stl</uri>
                    </mesh>
                </geometry>
            </collision>
            <visual name="visual">
              <pose>0 0 0.05 0 0 0</pose>
              <geometry>
              <mesh>
                 <uri>model://5qr/meshes/qr5.dae</uri>
              </mesh>
              </geometry>
             </visual>
        </link>    

      <link name='chassis'>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <!-- Масса уменьшена в 8 раз (2^3) из-за объемного масштабирования -->
          <mass>0.142994</mass>
          <inertia>
            <!-- Моменты инерции уменьшены в 32 раза (2^5) -->
            <ixx>0.003942</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.013016</iyy>
            <iyz>0</iyz>
            <izz>0.015032</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <geometry>
            <box>
              <!-- Размер уменьшен в 2 раза -->
              <size>0.25 0.275 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <!-- Размер уменьшен в 2 раза -->
              <size>0.25 0.275 0.1</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Колеса уменьшены в 2 раза -->
      <link name='front_left_wheel'>
        <pose>0.1 0.175 -0.0125 -1.5707 0 0</pose>
        <inertial>
          <!-- Масса уменьшена в 8 раз -->
          <mass>0.25</mass>
          <inertia>
            <!-- Моменты инерции уменьшены в 32 раза -->
            <ixx>0.004557</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.004557</iyy>
            <iyz>0</iyz>
            <izz>0.003906</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0 0 0 1.5707 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_left.STL</uri>
              <!-- Масштаб уменьшен в 2 раза -->
              <scale>0.0015 0.0015 0.0015</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <!-- Радиус уменьшен в 2 раза -->
            <sphere>
              <radius>0.085</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="chassis">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name='rear_left_wheel'>
        <pose>-0.1 0.175 -0.0125 -1.5707 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.004557</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.004557</iyy>
            <iyz>0</iyz>
            <izz>0.003906</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0 0 0 1.5707 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_right.STL</uri>
              <scale>0.0015 0.0015 0.0015</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere>
              <radius>0.085</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="chassis">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name='front_right_wheel'>
        <pose>0.1 -0.175 -0.0125 -1.5707 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.004557</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.004557</iyy>
            <iyz>0</iyz>
            <izz>0.003906</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0 0 0 1.5707 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_right.STL</uri>
              <scale>0.0015 0.0015 0.0015</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere>
              <radius>0.085</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="chassis">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name='rear_right_wheel'>
        <pose>-0.1 -0.175 -0.0125 -1.5707 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.004557</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.004557</iyy>
            <iyz>0</iyz>
            <izz>0.003906</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0 0 0 1.5707 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum lift/tip/files/meshes/mecanum_wheel_left.STL</uri>
              <scale>0.0015 0.0015 0.0015</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere>
              <radius>0.085</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>0.0</mu2>
                <fdir1 gz:expressed_in="chassis">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- joint остается без изменений -->
      <joint name='qr_joint' type='fixed'>
        <parent>chassis</parent>
        <child>qr5</child>
        <axis>
          <xyz>0 0 1</xyz>
        </axis>
      </joint>

      <!-- joints остаются без изменений -->
      <joint name='front_left_wheel_joint' type='revolute'>
        <parent>chassis</parent>
        <child>front_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name='front_right_wheel_joint' type='revolute'>
        <parent>chassis</parent>
        <child>front_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name='rear_left_wheel_joint' type='revolute'>
        <parent>chassis</parent>
        <child>rear_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name='rear_right_wheel_joint' type='revolute'>
        <parent>chassis</parent>
        <child>rear_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <plugin
        filename="gz-sim-mecanum-drive-system"
        name="gz::sim::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <!-- Параметры уменьшены в 2 раза -->
        <wheel_separation>0.625</wheel_separation>
        <wheelbase>0.7555</wheelbase>
        <!-- Радиус колеса уменьшен в 2 раза -->
        <wheel_radius>0.15</wheel_radius>
        <min_acceleration>-5</min_acceleration>
        <max_acceleration>5</max_acceleration>
      </plugin>

    </model>
</sdf>
